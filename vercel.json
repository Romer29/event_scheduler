{
  "version": 2,
  "builds": [
    {
      "src": "event_scheduler_project/manage.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "event_scheduler_project/manage.py"
    }
  ],
  "installCommand": "pip install -r event_scheduler_project/requirements.txt"
}